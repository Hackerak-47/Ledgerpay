# LedgerPay — Environment Variables Example
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env with real secrets to version control.

# ─── Database ───────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/ledgerpay
DB_USERNAME=ledgerpay
DB_PASSWORD=ledgerpay_secret

# ─── JWT ────────────────────────────────────────────────────────────────────
# Generate a secure random 256-bit secret for production:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-secure-random-256-bit-secret-for-production
JWT_EXPIRATION_MS=3600000

# ─── Fraud Detection (configurable thresholds) ───────────────────────────────
FRAUD_MAX_TRANSFERS_PER_MINUTE=5
FRAUD_LARGE_TRANSFER_THRESHOLD=10000

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# ─── Frontend ────────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8080/api
